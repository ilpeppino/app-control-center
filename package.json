{
  "name": "app-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:dashboard",
    "dev:server": "npm --workspace @control-center/server run dev",
    "dev:dashboard": "npm --workspace @control-center/dashboard run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "apps/*",
    "packages/core",
    "packages/cli",
    "packages/adapters/*"
  ],
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5"
  }
}
