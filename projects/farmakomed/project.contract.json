{
  "$schema": "../../packages/core/schemas/project-contract.schema.json",
  "projectId": "farmakomed",
  "displayName": "FarmakoMed",
  "adapterName": "farmakomed",
  "repoPath": "/Volumes/DevSSD/projects/farmakomed",
  "environments": ["dev", "prd"],
  "flagFiles": {
    "dev": "src/services/features/featureFlags.dev.ts",
    "prd": "src/services/features/featureFlags.prd.ts"
  },
  "validationCommands": {
    "dev": "npm run ci:validate",
    "prd": "npm run ci:validate"
  },
  "deployCommands": {
    "dev": "npm run build:android:apk:dev",
    "prd": "npm run build:android:apk:prd"
  },
  "rollback": {
    "snapshotPath": "projects/farmakomed/snapshots",
    "retentionDays": 30
  },
  "safetyRules": {
    "productionRequiresConfirmation": true,
    "highRiskProductionRequiresAcknowledgement": true,
    "createRollbackSnapshotBeforeApply": true,
    "blockDeployIfValidationFails": true
  },
  "featureFlags": [
