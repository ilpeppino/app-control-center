# Dependencies
node_modules/

# Build output
dist/
build/
apps/*/dist/
apps/*/build/
packages/*/dist/
packages/*/build/
packages/adapters/*/dist/
packages/adapters/*/build/

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/

# Local environment/config overrides
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS/editor metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Runtime temp/cache files
.cache/
.vite/
tmp/
temp/
*.tmp

# Rollback snapshots are local safety artifacts.
# Keep snapshot directories via .gitkeep, but do not commit generated snapshot payloads.
projects/*/snapshots/*.json
